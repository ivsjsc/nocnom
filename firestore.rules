rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SECURITY: Deny-by-default. Collection rules below explicitly grant access.
    // --- HELPER FUNCTIONS ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- NHÓM 1: DỮ LIỆU CHUNG (DISHES & TIMETABLE) ---
    match /dishes/{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    match /timetable/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // --- NHÓM 2: DỮ LIỆU CÁ NHÂN NGƯỜI DÙNG ---
    // nOcnOm profile is private and uses an explicit field allow-list.
    match /users/{userId}/profile/{profileId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'fullName',
          'dateOfBirth',
          'school',
          'faculty',
          'studentId',
          'phone',
          'photoUrl',
          'gender',
          'heightCm',
          'weightKg',
          'activityLevel',
          'healthGoal',
          'email',
          'authProvider',
          'updatedAt'
        ])
        && (!('gender' in request.resource.data)
          || request.resource.data.gender in ['male', 'female', 'other', ''])
        && (!('heightCm' in request.resource.data)
          || request.resource.data.heightCm == ''
          || (request.resource.data.heightCm is number
            && request.resource.data.heightCm >= 80
            && request.resource.data.heightCm <= 240))
        && (!('weightKg' in request.resource.data)
          || request.resource.data.weightKg == ''
          || (request.resource.data.weightKg is number
            && request.resource.data.weightKg >= 25
            && request.resource.data.weightKg <= 220))
        && (!('activityLevel' in request.resource.data)
          || request.resource.data.activityLevel in ['sedentary', 'light', 'moderate', 'active', ''])
        && (!('healthGoal' in request.resource.data)
          || request.resource.data.healthGoal in ['maintain', 'lose', 'gain', '']);
      allow delete: if isOwner(userId);
    }

    // Legacy v1 appState remains readable/writable temporarily for
    // backwards compatibility. Schema v2 migrates without deleting v1.
    match /users/{userId}/data/{dataId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'timetable',
          'dishes',
          'categories',
          'logs',
          'updatedAt'
        ]);
      allow delete: if isOwner(userId);
    }

    // nOcnOm schema v2 splits large appState domains into independent docs.
    match /users/{userId}/state/{stateId} {
      allow read: if isOwner(userId);

      allow create, update: if isOwner(userId)
        && request.resource.data.schemaVersion == 2
        && (
          (
            stateId == 'timetable'
            && request.resource.data.keys().hasOnly([
              'value',
              'schemaVersion',
              'updatedAt'
            ])
            && request.resource.data.value is map
          )
          ||
          (
            (
              stateId == 'dishes'
              || stateId == 'categories'
              || stateId == 'logs'
              || stateId == 'mealAddons'
            )
            && request.resource.data.keys().hasOnly([
              'items',
              'schemaVersion',
              'updatedAt'
            ])
            && request.resource.data.items is list
          )
          ||
          (
            stateId == 'meta'
            && request.resource.data.keys().hasOnly([
              'schemaVersion',
              'migrationSource',
              'mediaPolicy',
              'updatedAt'
            ])
            && request.resource.data.migrationSource is string
            && (!('mediaPolicy' in request.resource.data)
              || request.resource.data.mediaPolicy == 'PUBLIC_URL_ONLY')
          )
        );

      allow delete: if isOwner(userId);
    }

    // No unmodeled user subcollection is implicitly exposed.
    match /users/{userId}/{document=**} {
      allow read, write: if false;
    }

    // --- NHÓM 3: BINOC APP (Messages, Rooms, Calls, FCM) ---
    
    // Tin nhắn: Ai cũng có thể đọc/tạo, nhưng chỉ người gửi mới được sửa/xóa
    match /messages/{messageId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
    }

    // Phòng họp và các ứng viên WebRTC
    match /rooms/{roomId} {
      allow read, write: if isAuthenticated();
      
      match /offerCandidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }
      match /answerCandidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Cuộc gọi và các ứng viên WebRTC
    match /calls/{callId} {
      allow read, write: if isAuthenticated();
      
      match /offerCandidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }
      match /answerCandidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Token thông báo (FCM): Chỉ chủ sở hữu mới được quản lý
    match /fcmTokens/{tokenId} {
      allow create, update: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.token == tokenId;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if false; // Bảo mật token, không cho phép liệt kê
    }

    // --- NHÓM 4: SHARED LEDGERS (Sổ thu chi dùng chung) ---
    match /ledgers/{ledgerId} {
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow list, read: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // Thành viên trong sổ
      match /members/{userId} {
        allow list: if isAuthenticated();
        allow read: if isAuthenticated() && userId == request.auth.uid;
        allow create, update, delete: if isAuthenticated() 
          && get(/databases/$(database)/documents/ledgers/$(ledgerId)).data.ownerId == request.auth.uid;
      }

      // Các dữ liệu con (Expenses, Savings, Diary...) yêu cầu phải là thành viên của Ledger
      function isLedgerMember() {
        return exists(/databases/$(database)/documents/ledgers/$(ledgerId)/members/$(request.auth.uid));
      }

      match /settings/{settingsId} {
        allow read, write: if isAuthenticated() && isLedgerMember();
      }
      match /expenses/{expenseId} {
        allow read, write: if isAuthenticated() && isLedgerMember();
      }
      match /savings/{savingsId} {
        allow read, write: if isAuthenticated() && isLedgerMember();
      }
      match /fund/{fundId} {
        allow read, write: if isAuthenticated() && isLedgerMember();
      }
      match /diaryEntries/{entryId} {
        allow read: if isAuthenticated() && isLedgerMember();
        allow create: if isAuthenticated() && isLedgerMember() && request.resource.data.author == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.author == request.auth.uid;
      }
      match /notifications/{notificationId} {
        allow read, write: if isAuthenticated() && isLedgerMember();
      }
      match /metadata/{document=**} {
        allow read, write: if isAuthenticated() && isLedgerMember();
      }
    }

    // SECURITY: No global catch-all. Unmatched collections are denied.
    // This is required so /users/{otherUid}/... remains private even when
    // another authenticated user is signed in.
  }
}